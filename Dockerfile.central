FROM eclipse-temurin:21-jre

WORKDIR /app

COPY target/spaghetti-chef-*-central-vps.jar /app/spaghetti-chef-central-vps.jar

ENV SPAGHETTICHEF_MODE=central
ENV CENTRAL_MODE=true
ENV CENTRAL_REPLAY_STORAGE_DIR=/data/replay
ENV JAVA_OPTS="-Dspaghettichef.api.port=8080 -Dspaghettichef.central.databaseFile=/data/spaghettichef-central.db"

VOLUME ["/data"]

EXPOSE 8080

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/spaghetti-chef-central-vps.jar"]
